#!/bin/bash
# claude for the Hindsight plugin's headless codebase survey (HINDSIGHT_CLAUDE_BIN).
# Hooks run without CLAUDE_CODE_OAUTH_TOKEN; restore it from the file hindsight-setup writes.
token_file="${XDG_CONFIG_HOME:-$HOME/.config}/hindsight/claude-oauth-token"
if [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && [ -r "$token_file" ]; then
  CLAUDE_CODE_OAUTH_TOKEN="$(cat "$token_file")"
  export CLAUDE_CODE_OAUTH_TOKEN
fi
exec claude "$@"
