#!/bin/bash
# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
set -euo pipefail

{{ $mise := lookPath "mise" -}}
{{ if not $mise }}{{ $mise = (joinPath .chezmoi.homeDir ".local/bin/mise") }}{{ end -}}
# trust the just-deployed global config so a fresh host/container can install
"{{ $mise }}" trust "{{ joinPath .chezmoi.homeDir ".config/mise/config.toml" }}"
"{{ $mise }}" install
