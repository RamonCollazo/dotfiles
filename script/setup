#!/bin/bash
set -euo pipefail

export HOME="${HOME:-/home/vscode}"
mkdir -p "$HOME/.local/bin"
export PATH="$HOME/.local/bin:$PATH"

tmpfiles=()
cleanup() { rm -f "${tmpfiles[@]}"; }
trap cleanup EXIT
require() { command -v "$1" >/dev/null 2>&1 || { echo "error: '$1' is required" >&2; exit 1; }; }
require curl
require git

# --- personal tier: chezmoi + mise ---
if ! command -v chezmoi >/dev/null 2>&1; then
  installer="$(mktemp)"; tmpfiles+=("$installer")
  curl -fsLS get.chezmoi.io -o "$installer"
  sh "$installer" -b "$HOME/.local/bin" init --apply RamonCollazo
else
  chezmoi init --apply RamonCollazo
fi

mise_bin="$(command -v mise || echo "$HOME/.local/bin/mise")"
if ! grep -q "mise activate" "$HOME/.bashrc" 2>/dev/null; then
  {
    echo ""
    echo "# mise activation (added by dotfiles script/setup)"
    echo 'export PATH="$HOME/.local/bin:$PATH"'
    echo "eval \"\$(\"$mise_bin\" activate bash)\""
  } >> "$HOME/.bashrc"
fi

# --- knowledge vault: cloned under $HOME so it matches the vault's own
#     ~/Projects/claude-obsidian/ references (host: /home/ramon,
#     container: /home/vscode -> both resolve as ~). Non-fatal on failure.
#     Auth: needs FORGEJO_TOKEN in the env (injected by the fish/bash `devpod`
#     wrapper or `dup`). Without it the clone is skipped — a plain clone would make
#     devpod proxy credentials to the host and trigger an interactive login popup. ---
VAULT_DIR="$HOME/Projects/claude-obsidian"
VAULT_URL="https://forgejo.raymondcollazo.com/ramon/claude-obsidian"
if [ ! -d "$VAULT_DIR/.git" ]; then
  mkdir -p "$(dirname "$VAULT_DIR")"
  if [ -n "${FORGEJO_TOKEN:-}" ]; then
    # Embed the token in the clone URL so git consults NO credential helper —
    # this avoids devpod's git-credential forwarding, which otherwise proxies to
    # the host and triggers an interactive login popup. Scrub the token from the
    # stored remote afterwards; future pushes use the env-token helper.
    if GIT_TERMINAL_PROMPT=0 git clone \
         "https://oauth2:${FORGEJO_TOKEN}@forgejo.raymondcollazo.com/ramon/claude-obsidian" \
         "$VAULT_DIR"; then
      git -C "$VAULT_DIR" remote set-url origin "$VAULT_URL"
      git -C "$VAULT_DIR" config credential.helper '!f() { echo username=oauth2; echo "password=$FORGEJO_TOKEN"; }; f'
    else
      echo "warn: vault clone failed; continuing without it" >&2
    fi
  else
    # No token (plain `command devpod up` / GUI / bash). Skip rather than letting
    # git ask devpod -> host for credentials, which triggers an interactive login
    # popup. Launch via the fish `devpod` wrapper or `dup` to get FORGEJO_TOKEN.
    echo "warn: FORGEJO_TOKEN unset -> skipping vault clone (use the devpod fish wrapper or dup)" >&2
  fi
fi

# --- kiro-cli: idempotent, download-then-run (no blind curl|bash) ---
# NOTE: mise registry entry broken upstream; re-enable in dot_config/mise/config.toml when fixed.
if ! command -v kiro-cli >/dev/null 2>&1; then
  kiro_installer="$(mktemp)"; tmpfiles+=("$kiro_installer")
  curl -fsSL https://cli.kiro.dev/install -o "$kiro_installer"
  bash "$kiro_installer"
fi
